<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="school_absensi_view_list" model="ir.ui.view">
    <field name="name">school.absensi.view.list</field>
    <field name="model">school.absensi</field>
    <field name="arch" type="xml">
      <list string="Absensi Data">
        <field name="absensi_date"/>
        <field name="state"/>
      </list>
    </field>
  </record>

  <record id="school_absensi_view_form" model="ir.ui.view">
    <field name="name">school.absensi.view.form</field>
    <field name="model">school.absensi</field>
    <field name="arch" type="xml">
      <form string="Absensi Data">
        <sheet>
          <group>
            <group>
              <field name='absensi_date' readonly="state=='done'" ></field>
            </group>
            <group>
              <field name="state"/>
            </group>
          </group>
          <notebook>
            <page string="Student List">
              <field name="student_ids" readonly="state=='done'" >
                <list>
                  <field name="name" />
                  <field name="student_class" />
                </list>    
              </field>
            </page>
            <page string="Status Information">
              <group>
                <field name="state" readonly="state=='done'" ></field>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
