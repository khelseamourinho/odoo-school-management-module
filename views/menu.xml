<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="action_school_absensi" model="ir.actions.act_window">
    <field name="name">Absensi Data</field>
    <field name="res_model">school.absensi</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[]</field>
    <field name="context">{}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smilling_face">
        Define your absensi student here.
      </p>
    </field>
  </record>


  <record id="action_school_student" model="ir.actions.act_window">
    <field name="name">Student Data</field>
    <field name="res_model">school.student</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[]</field>
    <field name="context">{}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smilling_face">
        Define your student data here.
      </p>
    </field>
  </record>

  <menuitem
    id="school_apps_root_menu"
    name="School App"
    sequence="10" />

  <menuitem
    id="school_apps_absensi_menu"
    name="Absensi Data"
    action="action_school_absensi"
    parent="school_apps_root_menu"
    sequence="1" />
    
  <menuitem
    id="school_apps_student_menu"
    name="Students Data"
    action="action_school_student"
    parent="school_apps_root_menu"
    sequence="10" />


</odoo>