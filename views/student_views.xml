<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="school_student_view_list" model="ir.ui.view">
    <field name="name">school.student.view.list</field>
    <field name="model">school.student</field>
    <field name="arch" type="xml">
      <list string="Student Data">
        <field name="name" />
        <field name="student_class" />
        <field name="state" />
      </list>
    </field>
  </record>

  <record id="school_student_view_form" model="ir.ui.view">
    <field name="name">school.student.view.form</field>
    <field name="model">school.student</field>
    <field name="arch" type="xml">
      <form string="Student Data">
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="set_graduate" string="Set Graduate" type="object" class="fa fa-check-circle" />
          </div>
          <group>
            <group>
              <field name="name" />
            </group>
            <group>
              <field name="student_class" />
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>
</odoo>